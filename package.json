{
  "name": "liangbin-site",
  "description": "Bilingual research, writing, and independent projects built with Hugo.",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Liangbin Zhao",
  "scripts": {
    "dev": "hugo server --environment preview --disableFastRender",
    "build": "hugo --gc --minify --forceSyncStatic",
    "preview": "hugo server --environment preview --disableFastRender --minify",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:ai-markdone": "node scripts/verify-ai-markdone-site.mjs",
    "format": "prettier --write \"layouts/**/*.html\" \"assets/**/*.{css,js}\" \"data/**/*.json\" \"scripts/*.mjs\" package.json"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-go-template": "0.0.15"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-go-template"
    ],
    "overrides": [
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "go-template"
        }
      }
    ]
  }
}
